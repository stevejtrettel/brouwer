---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { demoUrl } from '../../lib/paths.ts';

export async function getStaticPaths() {
  const theorems = await getCollection('theorems', ({ data }) => !data.draft);
  return theorems.map((entry) => ({
    params: { theorem: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'theorems'>;
}

const { entry } = Astro.props;
// The demos are no longer synced in as committed bundles: they are built from
// this same repo by scripts/site.mjs and land at /d/<name>/. In dev they come
// from the demo hub on :5173 instead. See src/lib/paths.ts.
const demoSrc = demoUrl(entry.data.demo);
---

<Base title={`Play — ${entry.data.shortTitle}`} bare>
  <div class="play-page">
    <div class="play-bar">
      <a href={`/${entry.id}/`}>&larr; {entry.data.shortTitle}</a>
      <span class="title">{entry.data.title}</span>
    </div>
    <iframe class="demo-frame" src={demoSrc} title={`${entry.data.title} — interactive demo`}
    ></iframe>
  </div>
</Base>
